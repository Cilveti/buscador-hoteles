{
  "extends": "../../apps/web/tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "typeRoots": ["../../apps/web/node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "react": ["../../apps/web/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../apps/web/node_modules/@types/react/*"],
      "react-dom/*": ["../../apps/web/node_modules/@types/react-dom/*"],
      "@/*": ["../../apps/web/src/*"],
      "@payload-config": ["../../apps/web/src/payload.config.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules"]
}
